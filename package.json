{
  "name": "sezaam-camera-tool",
  "version": "0.2.0",
  "private": true,
  "description": "Quasar \u2014 configuration locale et diagnostic de cam\u00e9ras IP",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "test": "vitest run",
    "test:ui": "node scripts/smoke.mjs",
    "start": "electron .",
    "launcher": "npm run brand:build && npm run build && node scripts/create-launcher.mjs",
    "setup:video": "node scripts/install-video.mjs",
    "format": "prettier --write src scripts tests *.ts package.json",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:forms": "node scripts/ui-fixtures.mjs",
    "brand:build": "node scripts/brand-build.mjs && node scripts/design-tokens.mjs",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "test:brand": "node scripts/brand-test.mjs",
    "test:stories": "node scripts/storybook-test.mjs",
    "test:visual": "node scripts/visual-test.mjs",
    "test:visual:update": "node scripts/visual-test.mjs --update",
    "launcher:install": "npm run launcher && node scripts/install-launcher.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "onvif": "0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.14.0",
    "electron": "44.9.0",
    "esbuild": "^0.28.2",
    "fontkit": "2.0.4",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "storybook": "10.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.12"
  },
  "productName": "Quasar"
}
