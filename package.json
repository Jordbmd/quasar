{
  "name": "sezaam-camera-tool",
  "version": "0.2.0",
  "private": true,
  "description": "Quasar — configuration locale et diagnostic de caméras IP",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run brand:build && tsc --noEmit && vite build && node scripts/build-main.mjs",
    "test": "vitest run",
    "test:ui": "node scripts/smoke.mjs",
    "start": "electron .",
    "launcher": "npm run build && node scripts/create-launcher.mjs",
    "setup:video": "node scripts/install-video.mjs",
    "format": "prettier --write src scripts tests stories .storybook \"*.ts\" \"*.cjs\" \"*.mjs\" \"*.json\"",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:forms": "node scripts/ui-fixtures.mjs",
    "brand:build": "node scripts/brand-build.mjs && node scripts/design-tokens.mjs",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "npm run brand:build && storybook build",
    "test:brand": "node scripts/brand-test.mjs",
    "test:stories": "node scripts/storybook-test.mjs",
    "test:visual": "node scripts/visual-test.mjs",
    "test:visual:update": "node scripts/visual-test.mjs --update",
    "launcher:install": "npm run launcher && node scripts/install-launcher.mjs",
    "check:types": "tsc --noEmit",
    "check:lint": "eslint src",
    "check:format": "prettier --check src scripts tests stories .storybook \"*.ts\" \"*.cjs\" \"*.mjs\" \"*.json\"",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs src",
    "check:dependencies": "knip",
    "package:dir": "npm run build && electron-builder --config electron-builder.config.cjs --dir --publish never",
    "validate:software": "npm run check:types && npm run check:lint && npm run check:format && npm run check:architecture && npm run check:dependencies && npm test && npm run build && npm run test:contrast && npm run test:forms"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "onvif": "0.8.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "18.7.0",
    "electron": "44.9.3",
    "electron-builder": "26.18.1",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "knip": "6.43.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.10",
    "sharp": "0.35.5",
    "storybook": "10.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^7.2.2",
    "vitest": "^4.1.12"
  },
  "productName": "Quasar",
  "engines": {
    "node": ">=24 <25"
  }
}
